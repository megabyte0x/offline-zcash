<?xml version="1.0" encoding="utf-8"?>
<!-- Never clone the invite keys or wallet state, including on OEM device-to-device transfers. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
